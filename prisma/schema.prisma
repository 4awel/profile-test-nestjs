generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  API
  DEVOPS
  TOOLS
}

model Profile {
  id String @id @default(uuid())

  slug        String @unique
  name        String
  title       String
  description String
  location    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links      Link[]
  skills     Skill[]
  experience Experience[]
  projects   Project[]

  @@map("profiles")
}

model Link {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  label String
  url   String
  order Int    @default(0)

  @@index([profileId])
  @@map("links")
}

model Skill {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name     String
  category SkillCategory
  order    Int           @default(0)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("skills")
}

model Experience {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company      String
  position     String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date") // null (для типов работающих по сей день)
  achievements String[]

  @@index([profileId, startDate])
  @@map("experience")
}

model Project {
  id String @id @default(uuid())

  profileId String  @map("profile_id")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  url          String
  technologies String[]
  order        Int      @default(0)

  @@index([profileId])
  @@map("projects")
}
