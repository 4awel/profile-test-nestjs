{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Jest гоняет тесты в ESM-режиме (Nest 12 — ESM-only),
    // поэтому здесь другой module, чем в сборке nest build.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"]
}
